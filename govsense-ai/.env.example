# Google Cloud Configuration
PROJECT_ID=govsense-ai-mvp
REGION=asia-south1
LOCATION=asia-south1

# Google Cloud Credentials
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# BigQuery Configuration
BIGQUERY_DATASET=govsense
BIGQUERY_RAW_DATASET=govsense_raw
BIGQUERY_METRICS_DATASET=govsense_metrics

# Vertex AI Configuration
VERTEX_AI_ENDPOINT_ID=your-endpoint-id
VERTEX_AI_MODEL_NAME=demand-forecast-model

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key

# Cloud Storage Configuration
GCS_BUCKET=govsense-data-lake
GCS_ML_BUCKET=govsense-ml-models

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_RELOAD=true

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8080
REACT_APP_MAPS_API_KEY=your-maps-api-key
REACT_APP_PROJECT_ID=govsense-ai-mvp

# Database (for local development)
DATABASE_URL=sqlite:///./govsense.db

# Security
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Feature Flags
ENABLE_GEMINI=true
ENABLE_VERTEX_AI=true
ENABLE_BIGQUERY=true
USE_MOCK_DATA=true
